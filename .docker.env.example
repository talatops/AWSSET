# AWS Chatbot - Environment Configuration Template
# Copy this file to .docker.env and fill in your actual values

# ================================
# DATABASE CONFIGURATION
# ================================
POSTGRES_DB=awschatbot
POSTGRES_USER=chatbot_user
POSTGRES_PASSWORD=your_secure_database_password_here
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://chatbot_user:your_secure_database_password_here@db:5432/awschatbot

# ================================
# REDIS CONFIGURATION
# ================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here
REDIS_DB=0

# ================================
# JWT & AUTHENTICATION
# ================================
SECRET_KEY=your_super_secret_jwt_key_minimum_32_characters_long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ================================
# OAUTH CONFIGURATION
# ================================
# Google OAuth (Get from: https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Proton OAuth (Get from: https://account.proton.me/api)
PROTON_CLIENT_ID=your_proton_client_id
PROTON_CLIENT_SECRET=your_proton_client_secret

# OAuth Redirect URLs (update for your domain)
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
PROTON_REDIRECT_URI=http://localhost:3000/auth/proton/callback

# ================================
# AWS CONFIGURATION (Optional - can be set via UI)
# ================================
# These are optional - users can set AWS credentials through the web interface
# AWS_ACCESS_KEY_ID=your_aws_access_key_id
# AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
# AWS_DEFAULT_REGION=us-east-1

# ================================
# GROQ AI CONFIGURATION
# ================================
# Get your API key from: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama3-8b-8192
GROQ_TEMPERATURE=0.1
GROQ_MAX_TOKENS=4096

# ================================
# CHATBOT CONFIGURATION
# ================================
CHATBOT_NAME=CloudGenie
CHATBOT_PERSONALITY=expert_aws_solutions_architect
CHATBOT_MAX_CONTEXT=10
CHATBOT_RESPONSE_TIMEOUT=30

# ================================
# INTENT CLASSIFICATION
# ================================
INTENT_CONFIDENCE_THRESHOLD=0.7
ENABLE_CONTEXT_MEMORY=true

# ================================
# SECURITY CONFIGURATION
# ================================
# IP Whitelist (comma-separated, leave empty to allow all)
IP_WHITELIST=127.0.0.1,localhost

# Rate Limiting
ENABLE_RATE_LIMITING=true
MAX_REQUESTS_PER_MINUTE=100
MAX_REQUESTS_PER_HOUR=1000

# Security Headers
ENABLE_SECURITY_HEADERS=true
ENABLE_CORS=true

# ================================
# NOTIFICATION CONFIGURATION
# ================================
# Email Configuration (for notifications)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_specific_password

# Slack Integration (optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# Twilio SMS (optional)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# ================================
# LOGGING CONFIGURATION
# ================================
LOG_LEVEL=INFO
ENABLE_STRUCTURED_LOGGING=true
LOG_FORMAT=json
ENABLE_FILE_LOGGING=true
LOG_FILE_PATH=/app/logs/app.log

# ================================
# DEVELOPMENT CONFIGURATION
# ================================
# Environment
ENVIRONMENT=development
DEBUG=false

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# API Configuration
API_PREFIX=/api
API_VERSION=v1

# ================================
# MONITORING & HEALTH CHECKS
# ================================
ENABLE_HEALTH_CHECKS=true
HEALTH_CHECK_INTERVAL=30
ENABLE_METRICS=true

# ================================
# CACHE CONFIGURATION
# ================================
ENABLE_CACHING=true
CACHE_TTL=300
AWS_STATS_CACHE_TTL=30

# ================================
# WEBSOCKET CONFIGURATION
# ================================
ENABLE_WEBSOCKET=true
WEBSOCKET_PING_INTERVAL=30
WEBSOCKET_PING_TIMEOUT=10
MAX_WEBSOCKET_CONNECTIONS=100

# ================================
# DOCKER CONFIGURATION
# ================================
# These are used by docker-compose
COMPOSE_PROJECT_NAME=awsset
DOCKER_BUILDKIT=1

# Port mappings (change if you have conflicts)
FRONTEND_PORT=3000
BACKEND_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379
NGINX_PORT=80
NGINX_SSL_PORT=443

# ================================
# PRODUCTION OVERRIDES
# ================================
# Uncomment and modify for production deployment

# Production Database (use managed database service)
# POSTGRES_HOST=your-rds-endpoint.amazonaws.com
# POSTGRES_PORT=5432

# Production Redis (use managed Redis service)
# REDIS_HOST=your-elasticache-endpoint.amazonaws.com
# REDIS_PORT=6379

# Production Security
# SECRET_KEY=super_secure_production_key_64_characters_minimum
# ENABLE_HTTPS=true
# SSL_CERT_PATH=/etc/ssl/certs/cert.pem
# SSL_KEY_PATH=/etc/ssl/private/key.pem

# Production URLs
# FRONTEND_URL=https://yourdomain.com
# BACKEND_URL=https://api.yourdomain.com

# Production OAuth Redirects
# GOOGLE_REDIRECT_URI=https://yourdomain.com/auth/google/callback
# PROTON_REDIRECT_URI=https://yourdomain.com/auth/proton/callback

# ================================
# FEATURE FLAGS
# ================================
# Enable/disable features
ENABLE_VOICE_INTERFACE=false
ENABLE_FILE_UPLOADS=true
ENABLE_ANALYTICS=true
ENABLE_CLOUDTRAIL_ANALYSIS=true
ENABLE_COST_OPTIMIZATION=true
ENABLE_SMART_NOTIFICATIONS=true

# ================================
# BACKUP CONFIGURATION
# ================================
ENABLE_AUTO_BACKUP=false
BACKUP_INTERVAL=24h
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=your-backup-bucket-name

# ================================
# IMPORTANT NOTES
# ================================
# 1. Never commit this file with real values to version control
# 2. Use strong, unique passwords for all services
# 3. For production, use environment-specific values
# 4. Regularly rotate secrets and API keys
# 5. Enable 2FA on all external services (AWS, Google, etc.)
# 6. Monitor logs for any suspicious activity
# 7. Keep this file secure and limit access

# ================================
# QUICK SETUP CHECKLIST
# ================================
# [ ] Copy this file to .docker.env
# [ ] Set strong database password
# [ ] Generate secure JWT secret key (32+ characters)
# [ ] Configure Google OAuth (console.cloud.google.com)
# [ ] Get Groq API key (console.groq.com)
# [ ] Set up AWS credentials (through UI or environment)
# [ ] Configure notification services (optional)
# [ ] Test the configuration with: docker-compose up -d
# [ ] Verify health: curl http://localhost:8000/api/health
