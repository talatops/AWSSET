# AWS Chatbot Frontend Dockerfile - Optimized with BuildKit cache
# Use this with: DOCKER_BUILDKIT=1 docker compose build

FROM node:18-slim

# Set working directory
WORKDIR /app

# Build arguments for React environment variables
ARG REACT_APP_API_URL=http://localhost:8000
ARG REACT_APP_WEBSOCKET_URL=ws://localhost:8000/ws/realtime

# Set environment variables
ENV NODE_ENV=development
ENV GENERATE_SOURCEMAP=false
ENV CHOKIDAR_USEPOLLING=true
ENV REACT_APP_API_URL=$REACT_APP_API_URL
ENV REACT_APP_WEBSOCKET_URL=$REACT_APP_WEBSOCKET_URL

# Configure npm for faster installs
ENV NPM_CONFIG_AUDIT=false
ENV NPM_CONFIG_FUND=false
ENV NPM_CONFIG_PROGRESS=false

# Copy package files
COPY package*.json ./

# Install dependencies with BuildKit cache mount (much faster on rebuilds)
RUN --mount=type=cache,target=/root/.npm \
    npm config set registry https://registry.npmjs.org/ && \
    npm config set fetch-retries 3 && \
    npm config set fetch-retry-mintimeout 20000 && \
    npm config set fetch-retry-maxtimeout 120000 && \
    npm install --legacy-peer-deps --no-audit --no-fund

# Copy project files
COPY . .

# Create non-root user for security
RUN groupadd -r nodejs && useradd -r -g nodejs reactjs && \
    chown -R reactjs:nodejs /app

USER reactjs

# Expose port
EXPOSE 3000

# Start the application
CMD ["npm", "start"]
